# Knowledge Snake - Environment Variables Example
# Copy this file to .env.local and fill in your values
# Never commit .env.local or any .env files with real credentials

# Vercel KV / Upstash Redis Configuration (Recommended for Vercel Deployment)
# Automatically populated by Vercel when you create a KV / Redis database in Vercel Storage
KV_REST_API_URL=https://your-kv-database.upstash.io
KV_REST_API_TOKEN=your-kv-rest-api-token

# Optional: Upstash Redis alternate variable names
UPSTASH_REDIS_REST_URL=https://your-kv-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-kv-rest-api-token

# Optional: Supabase Configuration (Not needed if using Vercel Database)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Game Logic Server URL (for ProductionTransport)
# NEXT_PUBLIC_GAME_LOGIC_URL=https://your-game-logic-server.com

# Optional: Transport type (mock | dev-server | production)
NEXT_PUBLIC_TRANSPORT_TYPE=production