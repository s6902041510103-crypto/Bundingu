# Knowledge Snake - Environment Variables Example
# Copy this file to .env.local and fill in your values
# Never commit .env.local or any .env files with real credentials

# Supabase Configuration
# Get these from your Supabase project dashboard: Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Game Logic Server URL (for ProductionTransport)
# NEXT_PUBLIC_GAME_LOGIC_URL=https://your-game-logic-server.com

# Optional: Transport type (mock | dev-server | production)
# NEXT_PUBLIC_TRANSPORT_TYPE=mock