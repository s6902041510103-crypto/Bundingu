# ==========================================
# Knowledge Snake Environment Configurations
# ==========================================

# Port (default: 3000)
PORT=3000

# Custom Persistent Storage Path (Optional: e.g. /var/data or /tmp/knowledge-snake-data)
# DATA_DIR=./.data

# Teacher Admin Master Password (Optional: if set, overrides default demo password)
# TEACHER_ADMIN_PASSWORD=your_secure_password_here

# Next.js Node Environment
NODE_ENV=production